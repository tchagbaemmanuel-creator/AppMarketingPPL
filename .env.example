# Supabase — https://supabase.com/dashboard/project/tdeucdnoohozogidhryc/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tdeucdnoohozogidhryc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# URL publique de l'application (liens dans les emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret pour signer les sessions et liens d'approbation
SESSION_SECRET=changez-moi-en-production-32-caracteres-min

# Brevo — https://app.brevo.com/settings/keys/api
# Utilisez la clé API classique (xkeysib-...), PAS la clé MCP ni la clé SMTP
BREVO_API_KEY=xkeysib-votre_cle_api
# Email expéditeur VÉRIFIÉ dans Brevo → Expéditeurs
BREVO_SENDER_EMAIL=noreply@votre-domaine.com
BREVO_SENDER_NAME=PPL Outils Marketing
# Optionnel : ID numérique de l'expéditeur Brevo (alternative à BREVO_SENDER_EMAIL)
# BREVO_SENDER_ID=1

# Email administrateur RÉEL (Gmail, Outlook, etc.) — reçoit les notifications
# Ne pas utiliser admin@ppl.local (adresse fictive de la base)
ADMIN_EMAIL=votre.email@gmail.com
